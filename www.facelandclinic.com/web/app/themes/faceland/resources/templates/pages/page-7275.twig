{% extends "base/base.twig" %}

{% block panorama %}
    	{% set slider = post.slider %}
        {% if slider|length > 0 %}
            <div class="c-carousel-wrapper">
                {% if slider|length > 1 %}
                    <div class="c-carousel-nav">
                        <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--prev u-bg-gray-darker js-carousel-prev">{{pll__('Vorige')}}</button>
                        <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--next u-bg-gray-darker js-carousel-next">{{pll__('Volgende')}}</button>
                    </div>
                {% endif %}
                <div class="c-carousel c-carousel--default js-panorama-carousel">
                    {% for panorama in slider %}
                        <div class="o-panorama c-panorama--mask c-panorama--vh c-panorama--light-background c-panorama--arrow u-flex-sm u-flex-center">
                            <figure class="o-panorama__image">
                                {{ rokit_get_image(panorama.image, 'video-panorama', panorama.title, '', '', false) }}
                            </figure>

                            {% if panorama.title or panorama.subtitle %}
                                <div class="o-panorama__content u-text-center" style="    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);">
                                    <div class="o-contain o-contain-padding">
                                        {% if panorama.title %}
                                            <h1 class="c-panorama__heading u-text-bold u-text-size-tera u-text-color-white js-animation-element a-fade-in">{{panorama.title}}</h1>
                                        {% endif %}
                                        {% if panorama.subtitle %}
                                            <p class="u-text-size-mega u-text-color-white js-animation-element a-fade-in">{{ panorama.subtitle }}</p>
                                        {% endif %}

                                        {% if panorama.show_button %}
                                            {% set external = panorama.button_external ? ' rel="external" data-router-disabled' %}
                                            <a href="{{ panorama.button_url }}" {{ external }} title="{{ panorama.button_label }}" class="c-btn u-text-medium c-btn--primary u-bg-primary u-text-size-epsilon u-text-medium c-panorama__heading-button">{{ panorama.button_label }}</a>
                                        {% endif %}
                                    </div>
                                </div>

                            {% endif %}

                            <span class="c-arrow c-arrow--down">{{pll__('Scroll naar beneden')}}</span>
                        </div>
                    {% endfor %}
                </div>    		
            	
                   			                
            </div>
        {% endif %}
    {# {{ dump(post.mobile_slider) }} #}
{% endblock %}

