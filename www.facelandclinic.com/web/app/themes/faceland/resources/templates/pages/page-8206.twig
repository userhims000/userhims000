{% extends "base/base.twig" %}

{% block panorama %}
    {% set maskClass =  contacts.online|length > 0 ? 'c-mask--smoke-white' %}
    {% include 'parts/panorama-default.twig' with { panorama : post.panorama, maskClass : maskClass} %}
{% endblock %}

{% block content %}
    <div class="u-bg-smoke-white">

        {% if post.questions.items|length > 0 %}
            <div class="o-contain o-contain-padding ">
                {% if post.questions.title %}
                       {% if is_nl == true or is_be == true %}
                            {% set clickVariable = post.questions.title|replace({'hier':"<a class='click-btn' href='javascript:;'>hier</a>"})  %}
                        {% else %}
                            {% set clickVariable = post.questions.title  %}    
                       {% endif %} 
                    <div class="c-intro u-text-size-mega u-text-color-gray-dark u-text-center" >{{ clickVariable }}</div>
                {% endif %}
                {% for card in post.questions.items %}
                    <div class="o-grid__cell o-grid__cell--center js-animation-element a-fade-in-up" {{ card.featherlight ? 'data-featherlight="#' ~ card.featherlight ~ '"'}}>
                        <div class="c-contacts c-contacts-btn" ></div>
                    </div>

                {% endfor %}
            </div>
        {% endif %}
        
        {% if post.appointment_book.items|length > 0 %}
            <div class="o-contain o-contain-padding">
            {% if is_nl %}
                {% set class = "c-cards-wrapper" %}
            {% else %}
                {% set class = "c-cards-wrappers" %}   
            {% endif %}    
            <div class="{{class}} ">
                <div class="c-cards">
                    {% for card in post.appointment_book.items %}
                        {% include 'parts/cards/card-appointments.twig' %}
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

{#         {% if contacts.online|length > 0 %}
