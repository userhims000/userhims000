<section class="mt-20 mb-0 mt-lg-56 mb-lg-56 pt-32 pb-48 p-lg-0 christmas-deals-section">
  <div class="o-contain o-contain-padding">
    <div class="o-grid o-grid--with-gutter u-1of1--sm u-1of1--md u-1of2--lg mb-n-24 align-items-center">
      <div class="o-grid__cell mt-0 mb-24">
        {% set titleTag = layout.christmas_page_deal_title_tag ? layout.christmas_page_deal_title_tag : 'h2' %}
        <div class="title title-25 u-text-bold u-text-center u-text-lg-left p-0 mb-24">
          <{{ titleTag }}>{{ layout.christmas_page_deal_title }}</{{ titleTag }}>
        </div>
        {% if layout.christmas_page_deal_description %}
          <div class="u-text-md-center u-text-lg-left">                          
            {{ layout.christmas_page_deal_description }}
          </div>
        {% endif %}
      </div>
      {% if layout.christmas_page_deal_image %}
       <div class="o-grid__cell mt-0 mb-24 u-text-center u-text-lg-right">                      
          {{ rokit_get_image(layout.christmas_page_deal_image, 'christmas-deal', layout.christmas_page_deal_title, '', '', false) }}
      {% endif %}
      </div> 
    </div> 
  </div>
</section>