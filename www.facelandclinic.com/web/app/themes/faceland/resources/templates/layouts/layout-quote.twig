{% if layout.quote or layout.quote_image or layout.title or layout.description or layout.label %}
    <blockquote class="c-highlight">
        <div class="u-text-size-mega u-text-italic">
            {{ layout.quote }}
        </div>

        {% if layout.caption %}
            <footer class="u-text-size-nano u-text-color-gray-darkest u-text-bold">— {{ layout.caption|upper }}</footer>
        {% endif %}
    </blockquote>
    {% if layout.quote_image %}
    <div class="c-intro--column become-younger-section">
        <div class="quote-image-section">
            <figure class="o-panorama__image">
                <img class="js-lazy-load is-lazy-loaded" data-src="{{ layout.quote_image }}" data-src-retina=""  src="{{ layout.quote_image }}">
            </figure>
        </div>    
    </div>
    {% endif %}
    {% if layout.title or layout.info_description or layout.label or layout.image %}
        <div class="c-intro--column treatment-finder-section" style="background-image: linear-gradient( rgb(255 255 255 / 72%), rgb(255 255 255 / 72%) ), url('{{ layout.image }}'); ">
            <div class="u-text-center">
                {% if layout.title %}
                    {% set titleTag  = layout.title_heading_tag ? layout.title_heading_tag : 'h1' %}
                    <{{titleTag}} class="u-text-bold section-title">{{ layout.title }}</{{titleTag}}>
                {% endif %}
                {{ layout.info_description }}
                {% if layout.label %}
                    {% set external = layout.external ? ' rel="external" data-router-disabled' %}
                    <a href="{{ layout.url }}" {{ external }} title="" class="c-btn u-text-small f-bg-primary-bg cta-button ">{{ layout.label }}</a>
                {% endif %}
            </div> 
        </div>
    {% endif %}    
{% endif %}

