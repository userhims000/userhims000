
{% if function('is_singular', 'location') != true and function('is_singular', 'ba_album') != true %}
    {% if layout.title or layout.sub_title or layout.content %}
        <div class="o-contain o-contain-padding treatment-title-content {{ is_mobile == true and get_clinic_post_type_slug == true ? 'clinic-page-title-content' : '' }}" id="{{ layout.scroll_section_element }}">
            {% if layout.title %}
                <div class="title u-text-bold {{ function('is_singular', 'location') == true and is_mobile != true ? 'u-text-left' : '' }} {{ function('is_singular', 'location') == true and is_mobile == true ? 'u-text-center' : '' }}">
                    <{{ layout.title_heading_tag }}>{{ layout.title }}</{{ layout.title_heading_tag }}>
                </div>
            {% endif %}
            {% if layout.sub_title %}
                <div class="sub-title u-text-bold {{ function('is_singular', 'location') == true and is_mobile != true ? 'u-text-left' : '' }}">
                    <{{ layout.sub_title_tag }}>{{ layout.sub_title }}</{{ layout.sub_title_tag }}>
                </div>
            {% endif %}
            <div class="treatment-two-col-content {{ (layout.content|length == 1) ? 'single-col' : '' }} {{ function('is_singular', 'location') == true and is_mobile == true ? 'u-text-center' : '' }}">
                {% if is_mobile != true %}
                    {% for content in layout.content %}
                        {% if content %}
                            <div class="treatment-content-description">
                                {{ content.content_description }}
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if is_mobile == true %}
                    {% set loopData = [] %}
                    {% for content in layout.content %}
                        {% if content %}
                            {% if not function('is_singular', 'blog_article')   %}                        
                                <div class="treatment-content-description">
                                    <div class="show-paragraph-content 1">
                                        {% if content.content_description|length > 200 %}
                                            {# {{ content.content_description|slice(0, 150) ~ '...' }} #}
                                            {% set truncated_content = content.content_description|slice(0, 200) %}
                                            {% set words = truncated_content|split(' ') %}
                                            {% set highlight_count = 5 %}
                                            {% set total_words = words|length %}
                                            {% set start_highlight_index = total_words > highlight_count ? total_words - highlight_count : 0 %}
                                            {% set before_highlight_words = words|slice(0, start_highlight_index)|join(' ') %}
                                            {% set highlight_words = words|slice(start_highlight_index, highlight_count)|join(' ') %}
                                            {{ before_highlight_words ~ ' <span class="grey-highlight">' ~ highlight_words ~ '...</span>' }}
                                        {% else %}
                                            {{ content.content_description }}
                                        {% endif %}
                                    </div>
                                    <div class="read-more-content">
                                        {{ content.content_description }}
                                    </div>
                                    {% if  content.content_description|length > 150 %}
                                        {% set loopData = ['yes'] %}
                                    {% endif %}    
                                </div>
                            {% endif %}
                            {% if function('is_singular', 'blog_article')  %}
                                <div class="treatment-content-description">
                                    {{ content.content_description }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
            {% if is_mobile == true %}
                {% if loopData is not empty %}
                    {% if not function('is_singular', 'blog_article')  %}
                        <div class="read-more-button" id="toggleReadMoreButton">
                            <div class="showMore">
                                 {{  (function('is_singular', 'location') != true) ? '<span> ' ~ pll__('Meer lezen') ~ ' </span>'  : '' }} <span><i class="arrow down"></i></span>  
                            </div>
                            <div class="showLess">
                                {{  (function('is_singular', 'location') != true) ? '<span> ' ~  pll__('Minder lezen') ~ '  </span>' : '' }}<span><i class="arrow up"></i></span>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
            {% endif %}

        </div> 
    {% endif %}
{% endif %}

