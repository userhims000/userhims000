                        {% if content.cta_button_two_label %}
                            <a href="{{ content.cta_button_two_url ? content.cta_button_two_url : 'javascript:;' }}" class="c-btn u-text-medium c-btn--gray-darker u-bg-gray-darker u-text-size-zeta two-btn">
