{% if function('is_singular', 'ba_album') == true %}
    <section class="mt-20 mt-lg-72 mb-20 mb-lg-72">
        <div class="treatment-title-content new-clinic-p">                 
          <div class="treatment-two-col-content single-col pb-0">
            <div class="border border-pink rounded py-16 px-24 px-lg-32 py-lg-24">
              {% if layout.title %}
                    <div class="title u-text-bold u-text-center p-0 mb-24">
                        <{{ layout.title_heading_tag }}>{{ layout.title }}</{{ layout.title_heading_tag }}>
                    </div>
                {% endif %}
