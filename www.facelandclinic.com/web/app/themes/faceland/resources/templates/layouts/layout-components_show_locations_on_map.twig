<script>


let map;
let marker;
let infoWindow;

async function initMap() {
    // Request needed libraries.
    const [{ Map }, { Marker }, { places }] = await Promise.all([
        google.maps.importLibrary("maps"),
        google.maps.importLibrary("marker"),
        google.maps.importLibrary("places"),
    ]);

    // Initialize the map.
    map = new google.maps.Map(document.getElementById("map"), {
        center: { lat: 52.2129919, lng: 5.2793703 }, // Default center
        zoom: 8,
        mapId: "4504f8b37365c3d0",
        mapTypeControl: false,
    });

    // Initialize the autocomplete input field
    const input = document.getElementById("locationInput");
    const autocomplete = new google.maps.places.Autocomplete(input, {
        componentRestrictions: { country: 'nl' },
    });

    // Bind the autocomplete to the map's bounds
    autocomplete.bindTo("bounds", map);

    // Create the marker and infoWindow
    marker = new google.maps.Marker({
        map,
        anchorPoint: new google.maps.Point(0, -29),
    });
    infoWindow = new google.maps.InfoWindow();

    // Display predefined locations on the map
    displayPredefinedLocations();

    // Handle the place selection event
    autocomplete.addListener("place_changed", () => {
        infoWindow.close();
        marker.setVisible(false);

        const place = autocomplete.getPlace();

        if (!place.geometry || !place.geometry.location) {
            window.alert("No details available for input: '" + place.name + "'");
            return;
        }

        // If the place has a viewport, fit to it; otherwise, center on the location
        if (place.geometry.viewport) {
            map.fitBounds(place.geometry.viewport);
        } else {
            map.setCenter(place.geometry.location);
            map.setZoom(8); // Adjust zoom level as needed
        }

        marker.setPosition(place.geometry.location);
        marker.setVisible(true);

        const content = `
            <div id="infowindow-content">
                <span id="place-displayname" class="title">${place.name}</span><br />
                <span id="place-address">${place.formatted_address}</span>
            </div>
        `;
        updateInfoWindow(content, place.geometry.location);
    });

    // Show user location on map
    initializeGeolocationMarker();
}

// Function to display predefined locations on the map
function displayPredefinedLocations() {
    const gmap = document.getElementById('map');
    const dataValue = gmap.getAttribute('data-attr');
    const locations = JSON.parse(dataValue);
    console.log(locations);

    for (let i = 0; i < locations.length; i++) {
        const locationMarker = new google.maps.Marker({
            position: new google.maps.LatLng(locations[i][1], locations[i][2]),
            map: map,
            title: locations[i][0],
        });

        google.maps.event.addListener(locationMarker, 'click', (function (locationMarker, i) {
            return function () {
                const content = `<div id="infowindow-content">
                    <span id="place-displayname" class="title">${locations[i][0]}</span><br />
                    <span id="place-address">${locations[i][3]}</span>, 
                    <span id="place-address">${locations[i][4]}</span>, 
                    <span id="place-address">${locations[i][5]}</span>
                </div>`;
                infoWindow.setContent(content);
                infoWindow.open(map, locationMarker);
            }
        })(locationMarker, i));
    }
}

// Helper function to create an info window.
function updateInfoWindow(content, center) {
    infoWindow.setContent(content);
    infoWindow.setPosition(center);
    infoWindow.open(map, marker);
}

// Function to initialize marker with user's geolocation
function initializeGeolocationMarker() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function (position) {
            const pos = new google.maps.LatLng(position.coords.latitude, position.coords.longitude);

            marker.setPosition(pos);
            map.setCenter(pos);
            map.setZoom(12); // Adjust zoom level to show user location more clearly
        });
    }
}

initMap();


</script>