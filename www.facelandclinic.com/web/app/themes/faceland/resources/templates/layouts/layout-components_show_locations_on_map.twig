{% set getLocations = google_map_locations(layout.all_locations) %}
<section class="mt-20 mt-lg-72 mb-20 mb-lg-72">
  <div class="treatment-title-content">                 
    <div class="treatment-two-col-content single-col pb-0">
      <div class="border border-pink rounded py-24 px-32">
        {% if layout.show_location_title %}
          <div class="title u-text-bold u-text-center p-0 mb-24">
            {% set titleTag = layout.show_location_title_tag ? layout.show_location_title_tag : 'h2' %}
            <{{ titleTag }}>{{ layout.show_location_title }}</{{ titleTag }}>
          </div>
        {% endif %}
        <div class="u-text-center mb-24">
          <input class="u-text-left" id="locationInput" type="text" placeholder="Enter your postal code or city name">
        </div>
        <div class="rounded h-100">
          <div id="map" class="my-map-img-div map-section rounded overflow-hidden h-100" data-attr='{{ getLocations }}'>
            {# <iframe src="https://www.google.com/maps?q=Faceland Capelle aan den IJssel, Rhijnspoor 223,Capelle a/d IJssel,2901 LB,38&amp;output=embed"></iframe> #}
          </div>
        </div>                   
      </div>
    </div>
  </div>
</section>


