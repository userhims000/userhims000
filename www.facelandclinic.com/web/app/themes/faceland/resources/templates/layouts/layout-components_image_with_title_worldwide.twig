{% if layout|length > 0 and ( layout.sub_title or layout.show_information|length ) %}
    {% set cls = '' %}
    {% if is_mobile != 1 %}
        {% set cls = 'o-contain o-contain-padding' %}
    {% endif %}    
    <div class="{{ cls }} worldwide-info-section {{ layout.remove_background_color == 1 ? 'remove-bg' : '' }}">   
        <div class="c-intro--column  c-d-global-section">
            {% if layout.show_information|length %}
                {% if layout.section_title %}
                    <div class="u-text-center">           
                        {% if layout.section_title %}
                            {% set bisubtitleTag  = layout.section_title_heading_tag ? layout.section_title_heading_tag : 'h2' %}
                            <{{bisubtitleTag}} class="u-text-bold section-sub-title">{{ layout.section_title }}</{{bisubtitleTag}}>
                        {% endif %}
                    </div>
                {% endif %}
                {% if is_mobile != true %}
                    <div class="c-cards-wrapper">
                         <div class="c-cards o-contain o-contain-padding full-background-image-section">
                            <div class="c-cards">
                                <div class="o-contain o-contain-padding m-auto o-grid js-filter-wrapper u-1of1--sm u-1of2--md u-1of4--lg o-grid--with-gutter o-grid--with-gutter-vertical">
                                    {% for details in layout.show_information %}
                                        {% set external = details.external ? ' rel="external" data-router-disabled' %}
                                        <div class="o-grid__cell a-inview">
                                            <div class="o-card">
                                                <figure class="o-card__image">
                                                    <img class="js-lazy-load is-lazy-loaded" data-src="{{ details.image.url }}" data-src-retina="" title="" alt="{{ details.image.alt }}" src="{{ details.image.url }}">
                                                </figure>
                                                <div class="o-card__content u-bg-white u-text-center">
                                                    <div class="specilist-info">
                                                        <p>{{ details.sub_title }}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                {% endfor %}
                                </div>
                            </div>
                        </div>    
                    </div>
                {% endif %}
                {% if is_mobile == true %}
                     <div class="o-contain o-contain-padding">
                        <div class="worldwide-why-faceland-section">
                            <div class="o-contain why-faceland-section">
                               <div class="float-container">
                                  <div class="why-content-float-parts">
                                     <div class="two-part">
                                        {% for details in layout.show_information %}
                                            <div class="float-child">
                                               {% if details.mobile_image.url %} 
                                                   <div class="float-child-left">
                                                      <figure class="o-panorama__image">
                                                        <img class="js-lazy-load is-lazy-loaded" data-src="{{ details.mobile_image.url }}" data-src-retina="" title="" alt="{{ details.mobile_image.alt }}" src="{{ details.mobile_image.url }}">
                                                    </figure>
                                                   </div>
                                               {% endif %}                                                
                                                {% if details.sub_title %}
                                                   <div class="float-child-right">
                                                      <p>{{ details.sub_title }}</p>
                                                   </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                        {# <div class="two-part">
                                           <div class="float-child">
                                              <div class="float-child-left">
                                                 <figure class="o-panorama__image">                             
                                                    <img class="js-lazy-load is-lazy-loaded" data-src="https://www.facelandclinic.com/app/assets/iconen_locaties.png" title="" alt="https://www.facelandclinic.com/app/assets/iconen_locaties.png" src="https://www.facelandclinic.com/app/assets/iconen_locaties.png" loading="lazy" decoding="async">                         
                                                 </figure>
                                              </div>
                                              <div class="float-child-right">
                                                 <p>Altijd een Faceland bij</p>
                                              </div>
                                           </div>
                                           <div class="float-child">
                                              <div class="float-child-left">
                                                 <figure class="o-panorama__image">
                                                    <img class="js-lazy-load is-lazy-loaded" data-src="https://www.facelandclinic.com/app/assets/iconen_behandelingen.png" title="" alt="https://www.facelandclinic.com/app/assets/iconen_behandelingen.png" src="https://www.facelandclinic.com/app/assets/iconen_behandelingen.png" loading="lazy" decoding="async">                         
                                                </figure>
                                              </div>
                                              <div class="float-child-right">
                                                 <p>Er zijn al meer dan</p>
                                              </div>
                                           </div>
                                        </div> #}
                                     </div>
                                  </div>
                               </div>
                            </div>
                        </div>
                     </div>   
                {% endif %}    
            {% endif  %}
        </div>
    </div>
{% endif %}
