{% if layout|length > 0  and (layout.title or layout.sub_title or layout.locations|length ) %}
    <div class="iamhere-section o-grid faceland-home-slider">
        {% if layout.title or layout.description %}
            <div class="location-info-section">
                <div class="u-text-center">
                    {% set titleTag  = layout.title_heading_tag ? layout.title_heading_tag : 'h1'  %}
                    <{{titleTag}} class="u-text-bold section-title">{{ layout.title }}</{{titleTag}}>
                    <p class="u-text-size-alpha u-text-color-gray section-description">{{ layout.description }}</p>
                </div>
            </div>
        {% endif %}        
        {% if layout.locations|length %}
            <div class="location-slider">
                <div class="c-carousel-wrapper">
                    {% if layout.locations|length > 1 %}
                        <div class="c-carousel-nav">
                            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--prev u-bg-gray-darker js-carousel-prev">{{pll__('Vorige')}}</button>
                            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--next u-bg-gray-darker js-carousel-next">{{pll__('Volgende')}}</button>
                        </div>
                    {% endif %}
                    <div class="c-carousel c-carousel--default js-panorama-carousel">
                        {% for location in layout.locations %}
                            <div class="o-panorama c-panorama--mask c-panorama--vh c-panorama--light-background c-panorama--arrow u-flex-sm u-flex-center">
                                <figure class="o-panorama__image">
                                    <img class="js-lazy-load is-lazy-loaded" data-src="{{ location.location_image.url }}"  title="" alt="{{ location.location_image.alt }}" src="{{ location.location_image.url }}">
                                </figure>
                                {% if location.location_name %}
                                    <div class="o-panorama__content u-text-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);">
                                        <div class="o-contain o-contain-padding">
                                            {% if location.location_name %}
                                                {% set external = location.external ? ' rel="external" data-router-disabled' %}
                                                <a href="{{ location.url }}" {{ external }} title="" class="c-btn u-text-medium f-bg-primary-bg cta-button ">{{ location.location_name }}</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
