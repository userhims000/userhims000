<section class="o-panorama mt-0 mb-n-20 mb-n-lg-72">
  <div class="half-round-shape">
    <svg xmlns="http://www.w3.org/2000/svg" width="1512" height="128" viewBox="0 0 1512 128">
      <path id="Rectangle_2" data-name="Rectangle 2" d="M0,910l10.531,3.315A2480.979,2480.979,0,0,0,1512,910h0v128H0Z" transform="translate(0 -910)" fill="#f0e8de"/>
    </svg>
  </div>
  <div class="half-round-container py-20 py-lg-32">
    <div class="o-contain o-contain-padding overflow-hidden"> 
      <!--clinic-specialisten-section new start  -->                                    
      <div class="clinic-specialisten-section clinic-specialisten-section-new mb-20 mb-lg-72">

        <div class="sub-title u-text-bold u-text-center p-0 mb-16 mb-lg-72">
            {% if layout.clinic_consultation_section_title %}
                {% set titleTag  = layout.clinic_consultation_section_title_tag ? layout.clinic_consultation_section_title_tag : 'h1'  %}
                <{{titleTag}} class="u-text-bold title u-text-center">{{ layout.clinic_consultation_section_title }}</{{titleTag}}>
            {% endif %}
        </div>

        <div class="c-carousel-wrapper m-0 p-0">
         {% if layout.clinic_consulation_specialists|length > 4 %}
          <div class="c-carousel-nav">
            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow js-carousel-prev" aria-disabled="false">
              <i class="arrow left"></i>
            </button>
            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow js-carousel-next" aria-disabled="true">
              <i class="arrow right"></i>
            </button>
          </div>
        {% endif %}

          <div class="clinic-specialisten-list {{ (layout.clinic_consulation_specialists|length > 4 and is_mobile != true )  ? 'js-clinic-specialisten-list-carousel' : 'clinic-specialisten-grid c-carousel--default o-grid js-filter-wrapper u-1of1--sm u-1of2--md u-1of4--lg o-grid--with-gutter o-grid--with-gutter-vertical u-flex-center' }} {{ layout.clinic_consulation_specialists|length >= 2 and is_mobile == true ? 'js-clinic-specialisten-list-carousel-mobile-new' : '' }}">
            {% for item in layout.clinic_consulation_specialists %}
                <div class="clinic-specialisten-item o-panorama u-flex-sm u-flex-center o-grid__cell a-inview mt-0">
                    <div class="clinic-specialisten-box">
                      <figure class="o-panorama__image c-img-wrapper rounded">
                        {% set postPermalink = function('rokit_get_post_permalink', item.ID) %}
                        <a href="{{ postPermalink }}">
                            {{ rokit_get_image(item.custom.specialist_avatar, 'full', 'specialist-image') }}
                        </a>
                      </figure>
                      <div class="u-text-center clinic-image-below-title">
                        <a href="{{imgs.add_clinic_and_specialisten_image_link}}" class="u-flex-center" target="{{ (imgs.external == true) ? '_blank' : '' }}"><span>{{ item.custom.specialist_full_name }}</span></a>
                      </div>
                    </div>
                </div>
            {% endfor %}
          </div>
        </div>
      </div> 
        <!--clinic-specialisten-section new end  --> 
        {% if layout.consult_section_image or layout.consult_information_section_title or layout.consult_information_details or layout.cta_button_label  %}
           <!--cunsult-section new start  -->   
          <div class="cunsult-section-new">
            <div class="border border-white rounded p-24 py-lg-36 h-100">
              <div class="o-grid o-grid--with-gutter u-1of1--sm u-1of2--md mb-n-20">
                <div class="o-grid__cell u-cell-1of3--md mt-0 mb-20 align-self-center u-text-center">
                  {% if layout.consult_section_image %}
                    <div class="cunsult-image">
                        {{ rokit_get_image(layout.consult_section_image, 'full', 'men-women-img') }}
                    </div>
                  {% endif %}
                </div>
                <div class="o-grid__cell u-cell-2of3--md mt-0 mb-20">
                  <div class="px-lg-20">
                    {% if layout.consult_information_section_title %}
                        <h3 class="consult-h4 u-text-center mb-16">{{ layout.consult_information_section_title }}</h3>
                    {% endif %}
                    {{ layout.consult_information_details }}
                    <div class="u-text-center pt-32 pb-8">
                    {% set ctaButtonLabel = layout.cta_button_label ? layout.cta_button_label : '' %}
                    {% set ctaButtonURL = layout.cta_button_url ? layout.cta_button_url : 'javascript:;' %}
                    {% set ctaButtonExternal = layout.cta_button_url.cta_button_external ? ' rel="external" data-router-disabled' %}
                    {% if ctaButtonLabel %}
                        <a href="{{ ctaButtonURL }}" {{ ctaButtonExternal }}
                            class="c-btn u-text-medium c-btn--gray-darker u-bg-gray-darker u-text-size-zeta two-btn">
                            {{ ctaButtonLabel }}
                        </a>
                    {% endif %}
                    </div>                              
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--cunsult-section new end  --> 
        {% endif %}  
    </div>
  </div>
  <div class="half-round-shape">
    <svg xmlns="http://www.w3.org/2000/svg" width="1512" height="128" viewBox="0 0 1512 128">
      <path id="Rectangle_2" data-name="Rectangle 2" d="M0,1038l10.531-3.315A2480.979,2480.979,0,0,1,1512,1038h0V910H0Z" transform="translate(0 -910)" fill="#f0e8de"/>
    </svg>                  
  </div>
</section>