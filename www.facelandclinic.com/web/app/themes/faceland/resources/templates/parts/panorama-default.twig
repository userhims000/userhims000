    {% elseif is_ch == true %}
        {% set chPagetitle = current_page_slug %}
        {% if chPagetitle == "profhilo" %}
            {% set CHPageArgument = 'profhiloch'  %}
        {% elseif chPagetitle == "uebermaessiges-schwitzen" %}
            {% set CHPageArgument = 'hyperhidrosech'  %} 
        {% elseif chPagetitle == "uebermaessiges-schwitzen" %}
            {% set CHPageArgument = 'hyperhidrosech'  %}
        {% elseif chPagetitle == "lydia-oostveen-bol" %}
            {% set CHPageArgument = 'lydiabol'  %}                                                            
        {% endif %}        
    {% endif  %}
    
    {% if title == "oorlel" or title == "handen" or title == "full-face-treatment"  or title == "wangen" or title == "oberlidstraffung"  %}
        {% if  get_blog_post_type_slug == 'true' %}
        {% else  %}
            <div class="flexboxdata o-contain o-contain-padding">
                <div id="js-flowbox-flow"></div>
                <script type="text/javascript">
                    window.flowbox('init', {
                        container: '#js-flowbox-flow',
                        key: '42ktUTisSQOoniSzhCDU3Q',
                        locale: 'nl-NL',
                        tags: ['nl','voor_na','{{ pageArgument }}'],
                        tagsOperator: 'all'
                    });
                </script>
            </div>
        {% endif  %}    
    {% endif  %}

    {% if title == "lydia-oostveen-bol" or title == "marvin-eyra" or title == "diana-al-hadidi" or  title == "barof-sanaan" %}
        <div class="flexboxdata o-contain o-contain-padding">
            <div id="js-flowbox-flow"></div>
            <script type="text/javascript">
                window.flowbox('init', {
                    container: '#js-flowbox-flow',
                    key: 'C8wkv7fcQ2qOLeypH7Z7sw',
                    locale: 'nl-NL',
                    tags: ['{{ pageArgument }}'],  
                    tagsOperator: 'all'
                });
            </script>
        </div>
    {% endif  %} 
   

    {% if chPagetitle == "profhilo"  or chPagetitle == "bunny-lines" or chPagetitle == "bunny-lines" or chPagetitle == "uebermaessiges-schwitzen"   %}
        {% if  get_blog_post_type_slug == 'true' %}
        {% else  %}
            <div class="flexboxdata o-contain o-contain-padding">
                <div id="js-flowbox-flow"></div>
                <script type="text/javascript">
                    window.flowbox('init', {
                        container: '#js-flowbox-flow',
                        key: 'NrBMtvGBQzqOKIItxu7Nag',
                        tags: ['{{ CHPageArgument }}'],  
                        tagsOperator: 'all'
                    });
                </script>
            </div>
        {% endif  %}
    {% endif  %}

