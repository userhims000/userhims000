{% set cardClasses = carouselItem ? 'c-carousel__item' %}
{% set lazyload = carouselItem ? false : true %}

{% if card.thumbnail %}
    <div class="o-card c-card--simple c-card--bordered js-block {{cardClasses}}">
        <figure class="o-card__image">
            {{rokit_get_image(card.thumbnail, 'card', card.title, '', lazyload)}}
            {% include "parts/mask.twig" with { classes : 'c-mask--white' } %}
        </figure>

        <div class="o-card__content u-bg-white">
            <h2 class="o-card__heading u-text-size-beta u-text-bold"><a href="{{card.link}}" title="{{card.title}}">{{card.title}}</a></h2>
            {% if card.label %}
                <span class="o-label u-bg-primary u-text-size-nano u-text-color-white u-text-bold">{{card.label|upper}}</span>
            {% endif %}
        </div>
    </div>
{% endif %}
