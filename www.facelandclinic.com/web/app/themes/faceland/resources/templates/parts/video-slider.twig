<div class="c-carousel-wrapper">
    <div class="c-carousel c-carousel--video">
        <div class="c-carousel-nav">
            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--prev c-icon--opacity u-bg-gray-darker js-carousel-prev">{{pll__('Vorige')}}</button>
            <button class="c-icon c-icon--round c-icon--lg c-icon--arrow c-icon--next c-icon--opacity u-bg-gray-darker js-carousel-next">{{pll__('Volgende')}}</button>
        </div>
        <div class="js-video-carousel">
            {% for card in videos %}
                {% include "parts/cards/card-video-popup.twig" with { card : card } %}
            {% endfor %}
        </div>
    </div>
</div>
