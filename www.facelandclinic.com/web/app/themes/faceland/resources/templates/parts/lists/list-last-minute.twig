{% extends "parts/lists/list-academy.twig" %}

{% block listHeader %}
    {% if list.date_info %}
        <time class="c-list__heading u-text-bold u-size-1of8--md" datetime="{{ list.date_info|date("Y-m-d") }}">{{ list.date_info|date("d M")|upper }}</time>
    {% endif %}
    {% if list.title %}
        <span>{{ list.title }}</span>
    {% endif %}
{% endblock %}

{% block listData %}
    {% for data in list.data %}
        <div class="u-flex-md u-flex-center-y">
            {% if data.column_one %}
                <span class="c-list__heading u-size-1of8--md">{{ data.column_one }}</span>
            {% endif %}
            {% if data.column_two %}
                <span>{{ data.column_two }}</span>
            {% endif %}
            {% if data.column_three %}
                <span class="u-text-color-gray-darkest u-text-right u-align-right"><a href="{{data.column_three.link}}" title="{{data.column_three.fullname}}">{{data.column_three.fullname}}</a></span>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}

