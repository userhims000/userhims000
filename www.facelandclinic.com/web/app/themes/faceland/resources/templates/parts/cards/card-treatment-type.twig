{% set color = card.color ? 'secondary' : 'tertiary' %}
<div class="o-card c-card--big">
    <div class="o-grid">
        <div class="o-grid__cell u-cell-1of1--sm u-cell-1of3--lg u-cell-1of2--wd  u-bg-{{color}}-light">
            <div class="o-card__background u-flex-sm u-flex-center u-bg-{{color}}-light">
                {{rokit_get_image(card.image, 'avatar-hg', card.title, 'o-image--hg' )}}
            </div>
        </div>
        <div class="o-grid__cell u-cell-1of1--sm u-cell-2of3--lg u-cell-1of2--wd">
            <div class="o-card__content">
                <h2 class="o-card__heading u-text-size-beta u-text-bold">{{card.title}}</h2>
                <p class="o-card__text u-text-size-epsilon">{{card.intro_short}}</p>

                {% if card.featured_treatments %}
                    {% for row in card.featured_treatments|batch(2) %}
                        <div class="c-btn-group u-flex-md">
                            {% for item in row %}
                                <a class="c-btn c-btn--border c-btn--full c-btn--icon c-btn--arrow-next u-text-size-epsilon u-text-color-gray-darker u-text-medium u-bg-white u-size-1of2--md" href="{{item.link}}" title="{{item.title}}">{{item.title}}</a>
                            {% endfor %}
                        </div>
                    {% endfor %}
                {% endif %}

                <a class="c-btn c-btn--gray-darker u-bg-gray-darker u-text-size-zeta u-text-medium" href="{{card.link}}" title="{{ pll__('Bekijk alles') }}">
                    {% if is_be_fr == true %}
                        {{ pll__('Voir ici') }}
                    {% else %}
                        {{ pll__('Bekijk alles') }}
                    {% endif %}
                </a>

                <div class="c-mask-wrapper">
                    {% include "parts/mask-vertical.twig" with { classes : 'c-mask--' ~ color ~ '-light' } %}
                </div>
            </div>
        </div>
    </div>
</div>
