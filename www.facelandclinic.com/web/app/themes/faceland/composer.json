        }
    ],
    "require": {
        "php": ">=5.6.4",
        "composer/installers": "~1.0",
        "rokit/rodesk-packages-container": "~1.1.0",
        "rokit/rodesk-packages-config": "~1.1.0",
        "rokit/rodesk-packages-assets": "~1.0.2",
        "rokit/rodesk-packages-post-types": "~1.0.0",
        "timber/timber": "^1.1",
        "twig/twig": "~1.0"
    }
}
