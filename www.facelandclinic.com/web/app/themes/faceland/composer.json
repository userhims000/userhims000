{
    "name":     "rodesk/faceland",
    "type":     "wordpress-theme",
    "license":  "MIT",
    "description": "A theme biolerplate for buidling advanced wordpress themes. This theme uses the Twig template engine.",
    "homepage": "https://rodesk.com",
    "authors": [
        {
            "name": "Jasper Rooduijn",
            "email": "jasper.rooduijn@rodesk.nl",
            "homepage": "https://git.rodesk.nl/rodesk-wp-plugins/rokit-wp-theme.git"
        },
        {
            "name": "Joeri Abbo",
            "email": "joeri.abbo@rodesk.nl",
            "homepage": "https://git.rodesk.nl/rodesk-internal/rokit-wp.git"
        },
        {
            "name": "Tom harms",
            "email": "tom.harms@rodesk.nl",
            "homepage": "https://www.rodesk.com/tribe/tom-harms/"
        }
    ],
    "keywords": [
        "rodesk", "wordpress"
    ],
    "config": {
        "secure-http": false
    },
    "support": {
        "issues": "https://rodesk.com",
        "forum": "https://rodesk.com"
    },
    "autoload": {
