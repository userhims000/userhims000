{
    "name": "rodesk/faceland",
    "type": "project",
    "license": "MIT",
    "description": "A custom WordPress biolerplate for Rodesk projects (based on Bedrock by Roots)",
    "homepage": "https://www.rodesk.nl",
    "authors": [
        {
            "name": "Jasper Rooduijn",
            "email": "jasper.rooduijn@rodesk.nl",
            "homepage": "https://git.rodesk.nl/rodesk-internal/rokit-wp.git"
        },
        {
            "name": "Joeri Abbo",
            "email": "joeri.abbo@rodesk.nl",
            "homepage": "https://www.rodesk.com/tribe/joeri.abbo/"
        },
        {
            "name": "Tom harms",
            "email": "tom.harms@rodesk.nl",
            "homepage": "https://www.rodesk.com/tribe/tom-harms/"
        }
    ],
    "keywords": [
        "rodesk", "wordpress", "composer", "wp"
    ],
    "support": {
        "issues": "http://www.rodesk.nl",
        "forum": "http://www.rodesk.nl"
    },
    "config": {
        "secure-http": false,
        "preferred-install": "dist"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "type": "composer",
            "url": "https://packagist.org"
        },
        {
            "type": "composer",
            "url": "https://wp.rodeskpackages.nl/satispress"
        },
        {
            "type": "composer",
            "url": "https://packages.webnl.io/GWsbg0rmLlkPDqSzxoyRj21yy"
        },
        {
            "type": "composer",
            "url": "https://wp-languages.github.io"
        },
        {
            "type":"composer",
            "url":"https://composer.deliciousbrains.com/C0734C2DC099639F750B88730A25AA72"
        }
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "~1.0.12",
        "vlucas/phpdotenv": "2.0.1",
        "oscarotero/env": "^1.0",
        "wpackagist-plugin/duplicate-post": "~3.2",
        "wpackagist-plugin/intuitive-custom-post-order": "~3.1.0",
        "wpackagist-plugin/simple-history": "~2.19",
        "roots/wp-password-bcrypt": "1.0.0",
        "rodeskwp/advanced-custom-fields-pro": "5.9.0",
        "rodesk/rodesk-admin-core": "v2.1.7",
        "rodesk/rodesk-metabox-tabs": "~2.1.6",
        "rodeskwp/searchwp-polylang": "^1.2",
        "rodesk/rodesk-mobile-detect": "2.0.8",
        "johnpbloch/wordpress": "~6.0.1",
        "koodimonni-language/core-nl_nl": "~5.4.0",
        "wpackagist-plugin/classic-editor": "^1.0",
        "wpackagist-plugin/acf-content-analysis-for-yoast-seo":"2.6.0",
        "rokit/rodesk-packages-acf": "^1.1",
        "deliciousbrains-plugin/wp-migrate-db-pro": "^1.9",
        "deliciousbrains-plugin/wp-migrate-db-pro-media-files": "^1.4",
        "wpackagist-plugin/admin-menu-editor":"1.10.2",
        "drewm/mailchimp-api": "^2.5",
        "moneyphp/money": "^3.2",
        "wpackagist-plugin/unbounce": "^1.0",
        "rodeskwp/polylang-wc": "^1.2.2",
        "wpackagist-plugin/old-style-admin-ui": "^1.0",
        "rodeskwp/user-role-editor-pro": "^4.54",
        "rodeskwp/searchwp-custom-results-order": "^1.3",
        "rokit/languages": "^1.4",
        "rodeskwp/searchwp-redirects": "^1.4",
        "wpackagist-plugin/redirection": "^4.7",
        "rodeskwp/searchwp": "^4.2.3",
        "wpackagist-plugin/wordpress-seo": "19.2",
        "wpackagist-plugin/user-switching": "^1.5",
        "rodesk/review-scraper": "^1.0",
        "wpackagist-plugin/duracelltomi-google-tag-manager": "^1.11",
        "deliciousbrains-plugin/wp-migrate-db-pro-cli": "^1.3",
        "wpackagist-plugin/cbnet-multi-author-comment-notification": "^3.2",
        "wpackagist-plugin/google-sitemap-generator": "4.1.1",
        "wpackagist-plugin/optimole-wp": "3.0.1",
        "wpackagist-plugin/litespeed-cache": "^3.6",
        "timber/timber": "^1.20",
        "wpackagist-plugin/timber-library": "1.20.0",
        "symfony/http-foundation": "^3.3"
    },
    "require-dev": {
        "wpackagist-plugin/wp-crontrol": "~1.4",
        "wpackagist-plugin/transients-manager": "~1.8"
    },
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
            "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
            "web/app/themes/{$name}/": ["type:wordpress-theme"]
        },
        "dropin-paths": {
            "web/app/languages/": ["vendor:koodimonni-language"],
            "web/app/languages/plugins/": ["vendor:koodimonni-plugin-language"],
            "web/app/languages/themes/": ["vendor:koodimonni-theme-language"]
        },
        "wordpress-install-dir": "web/cms"
    }
}
